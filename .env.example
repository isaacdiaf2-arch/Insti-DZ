# Required Security & Database Secrets (minimum 32 chars for cryptographic secrets)
AUTH_SECRET=
STORAGE_SIGNING_SECRET=
DATABASE_URL=
TEST_DATABASE_URL=

# Public Application Origin (custom domain for signed URLs & sitemap.xml)
PUBLIC_URL=

# S3 / Cloudflare R2 Object Storage (required for persistent uploads in production)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Administrative & Governance Controls
ACTIVITY_LOG_PIN=
PLATFORM_OWNER_EMAIL=
SDZ_VAULT_IDENTIFIER=
SDZ_VAULT_PASSCODE=
SDZ_VAULT_EMAIL=

# Inbound Support/Trial Notification Delivery
SENDER_DOMAIN=
LOVABLE_API_KEY=

# Development-only Demo Mode (ignored/disabled automatically in production)
ENABLE_DEMO_MODE=false
VITE_ENABLE_DEMO_MODE=false